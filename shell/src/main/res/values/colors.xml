<?xml version="1.0" encoding="utf-8"?>
<!-- The shell's colours: neutral defaults, overridden by each app with its brand in its own res/values/colors.xml. -->
<resources>
    <color name="shell_signin_background">#FF000000</color>
    <color name="shell_signin_title">#FFFFFFFF</color>
    <color name="shell_signin_muted">#FFBDBDBD</color>
    <color name="shell_accent">#FFFFFFFF</color>
    <color name="shell_on_accent">#FF000000</color>
    <color name="shell_pull">#FF000000</color>
    <!-- The quiet "offline" bar over the page. -->
    <color name="shell_offline_bar">#FF3A3A3A</color>
    <color name="shell_offline_bar_text">#FFFFFFFF</color>
    <!-- The mark on the sign-in screen: the app's own (its launcher foreground, for example). -->
    <item name="shell_signin_mark" type="drawable">@android:drawable/sym_def_app_icon</item>
    <!-- The small icon of the app's notifications (one colour): the app's own. -->
    <item name="shell_notification_icon" type="drawable">@drawable/shell_ic_bell</item>
</resources>
