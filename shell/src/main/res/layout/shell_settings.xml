<?xml version="1.0" encoding="utf-8"?>
<!-- The native Settings screen: a bar with the way back, then the rows (SettingsActivity.Rows). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shell_settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/shell_settings_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/shell_back"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/shell_settings_title" />

    <FrameLayout
        android:id="@+id/shell_settings_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
