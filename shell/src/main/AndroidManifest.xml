<?xml version="1.0" encoding="utf-8"?>
<!-- The shell needs the network only; each app declares what its own features use (location, notifications…). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application>
        <!-- Photos taken with the camera app are written here before they are sent; an app adds paths in its own
             res/xml/shell_file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shell_file_paths" />
        </provider>
    </application>
</manifest>
